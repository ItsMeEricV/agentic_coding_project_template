# Per-worktree Docker env — contains DB credentials and NGROK_AUTHTOKEN.
# `.env.docker.example` is committed; the real `.env.docker` is per-worktree
# and MUST NOT be committed. Also covers any project-specific .env.docker.*
# variants (e.g. .env.docker.staging).
.env.docker
.env.docker.*
!.env.docker.example

# Framework / app env files — secrets at every level
.env
.env.local
.env*.local
.env.production

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# Build output
.next/
out/
dist/
build/

# Test / coverage
coverage/
*.lcov
.nyc_output/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel/
